# ---------------------------------------------------------------------------
# mail2ntfy environment configuration
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Compose reads ./.env automatically; in Dockhand, set these same keys as
# stack environment variables / secrets instead of committing a file.
# ---------------------------------------------------------------------------

# --- ntfy -----------------------------------------------------------------
# URL of your existing ntfy service as seen from inside the Docker network.
# "ntfy" is the container/service name and must be on the same Docker
# network (tunnel-net) as this watcher.
NTFY_URL=http://ntfy:80

# Topic all notifications are published to.
NTFY_TOPIC=email

# ntfy access token. Create one with e.g.:
#   docker exec -it ntfy ntfy token add <username>
# and grant publish rights on the topic with:
#   docker exec -it ntfy ntfy access <username> allow email rw
# Leave empty only if your ntfy server has access control disabled.
NTFY_TOKEN=

# --- behaviour -------------------------------------------------------------
# Seconds between mailbox checks when a server does not support IDLE.
POLL_INTERVAL=30
# Seconds to keep one IMAP IDLE session open before renewing it. Notifications
# arrive instantly via IDLE regardless; this only bounds how often the session
# is renewed and a safety-net poll is run. Clamped to 5-1740 (RFC 2177).
IDLE_TIMEOUT=300
# Reconnect backoff bounds (seconds). Base doubles on each failure up to max.
RECONNECT_BASE_DELAY=5
RECONNECT_MAX_DELAY=300
# INFO, WARNING, ERROR, DEBUG.
LOG_LEVEL=INFO

# --- Gmail -----------------------------------------------------------------
# USER is your full Gmail address. PASSWORD must be a Gmail App Password
# (https://myaccount.google.com/apppasswords), NOT your normal password.
GMAIL_USER=
GMAIL_PASSWORD=

# --- IMAP ----------------------------------------------------------------
# The watcher only monitors IMAP when both USER and PASSWORD are set.
# NAME is only the display label used in notifications.
IMAP_NAME=Personal IMAP
IMAP_USER=
IMAP_PASSWORD=
